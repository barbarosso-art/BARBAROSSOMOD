<vertical spacing='1.3' pad='2' child-expand-height='false' vertical-fit='PreferredSize'>
    <text text='Visibility' font-size='4.5' />

    <toggle-setting id='showInMenuToggle' text='Show in Menu' apply-on-change='true' on-change='OnShowInMenuChanged'
        pref-width='82' />

    <toggle-setting id='showInGameToggle' text='Show in Game' apply-on-change='true' on-change='OnShowInGameChanged'
        pref-width='82' />

    <button text='Close' on-click='OnCloseVisibilityClicked' pref-width='30' pref-height='8.5' />
</vertical>
