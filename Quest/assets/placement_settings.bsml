<vertical spacing='1.3' pad='2' child-expand-height='false' vertical-fit='PreferredSize'>
    <text text='Placement Settings' font-size='5' />

    <text id='placementInfoText' text='Tip: Enable Edit Mode and tap a placed image to edit it.' italics='true'
        word-wrapping='true' font-size='3.4' />

    <vertical id='settingsRoot' spacing='1.15' child-expand-height='false' vertical-fit='PreferredSize' active='false'>
        <text text='Basic' font-size='4' />
        <vertical id='nameKeyboardHost' spacing='0.35' child-expand-height='false' vertical-fit='PreferredSize' />

        <horizontal spacing='1.5' child-control-height='false' vertical-fit='PreferredSize'>
            <button text='Visibility...' on-click='OnOpenVisibilityClicked' pref-width='45' pref-height='8.5' />
            <button text='Size...' on-click='OnOpenSizeClicked' pref-width='45' pref-height='8.5' />
        </horizontal>

        <horizontal spacing='1.5' child-control-height='false' vertical-fit='PreferredSize'>
            <button text='Position...' on-click='OnOpenPositionClicked' pref-width='45' pref-height='8.5' />
            <button text='Rotation...' on-click='OnOpenRotationClicked' pref-width='45' pref-height='8.5' />
        </horizontal>

        <horizontal spacing='1.5' child-control-height='false' vertical-fit='PreferredSize'>
            <button text='Re-Center' on-click='OnRecenterClicked' pref-width='45' pref-height='8.5' />
            <button text='Delete Placed' on-click='OnDeletePlacementClicked' pref-width='45' pref-height='8.5' />
        </horizontal>

        <button text='Close' on-click='OnCloseClicked' pref-width='90' pref-height='8.5' />
    </vertical>
</vertical>
